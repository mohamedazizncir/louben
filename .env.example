# Copy this file to .env and fill the values. Never commit .env.

# Ports: service port = PORT_BASE + offset (see PLAN.md Section 4).
# If both sessions run on the same PC, session B uses PORT_BASE=8100.
PORT_BASE=8000
HOST=127.0.0.1

# LLM (any OpenAI compatible API). Leave LLM_API_KEY empty to run fully offline with fallbacks.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Check your provider console for a current model name.
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=8

# Human approval PIN for the dashboard (demo only).
HUMAN_PIN=2026

# Optional: Stripe TEST key (sk_test_...). Leave empty to use the simulated provider.
STRIPE_TEST_KEY=
